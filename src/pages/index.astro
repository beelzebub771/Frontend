---
import Layout from '../layouts/Layout.astro';
import "../styles/global.css";
import "../styles/home.css";

const categories = [
	{
		id: 'disfraces',
		number: '01',
		name: 'Disfraces',
		description: 'Tiburones, dinosaurios y otros crímenes contra el buen gusto.',
		image:
			'https://thumb.wikimedia.org/wikipedia/commons/thumb/9/98/2015_Hallowenn_dog_costume_party_1.jpg/960px-2015_Hallowenn_dog_costume_party_1.jpg',
		alt: 'Perro con disfraz en una fiesta de disfraces para mascotas',
		style: 'category-card--costumes',
	},
	{
		id: 'accesorios',
		number: '02',
		name: 'Accesorios',
		description: 'Gafas, sombreros y cero intención de pasar desapercibido.',
		image:
			'https://thumb.wikimedia.org/wikipedia/commons/thumb/1/15/2015_Hallowenn_dog_costume_party_4.jpg/960px-2015_Hallowenn_dog_costume_party_4.jpg',
		alt: 'Perro luciendo un complemento divertido en una fiesta de disfraces',
		style: 'category-card--accessories',
	},
	{
		id: 'bromas',
		number: '03',
		name: 'Artículos de broma',
		description: 'Pequeños objetos. Fotos que la familia nunca olvidará.',
		image:
			'https://thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/2015_Hallowenn_dog_costume_party_10.jpg/960px-2015_Hallowenn_dog_costume_party_10.jpg',
		alt: 'Mascota disfrazada durante una celebración de Halloween',
		style: 'category-card--jokes',
	},
];

const products = [
	{
		name: 'Tiburón de sofá',
		type: 'Disfraz · nivel leyenda',
		description: 'Aletas listas. Siestas intactas.',
		image:
			'https://thumb.wikimedia.org/wikipedia/commons/thumb/6/62/Shark_dog_costume_%288106433217%29.jpg/960px-Shark_dog_costume_%288106433217%29.jpg',
		alt: 'Perro disfrazado de tiburón',
		credit:
			'https://commons.wikimedia.org/wiki/File:Shark_dog_costume_(8106433217).jpg',
		creditName: 'Petful · Wikimedia Commons',
		style: 'product-card--shark',
	},
	{
		name: 'Jurassic Bark',
		type: 'Disfraz · rugido mini',
		description: 'Prehistórico por fuera. Buen chico por dentro.',
		image:
			'https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0e/T-rex_dog_costume_-_halloween_%288106456182%29.jpg/960px-T-rex_dog_costume_-_halloween_%288106456182%29.jpg',
		alt: 'Perro con un disfraz de dinosaurio T-rex',
		credit:
			'https://commons.wikimedia.org/wiki/File:T-rex_dog_costume_-_halloween_(8106456182).jpg',
		creditName: 'Petful · Wikimedia Commons',
		style: 'product-card--dino',
	},
	{
		name: 'Gafas de jefe',
		type: 'Accesorio · actitud incluida',
		description: 'Para supervisar la casa sin mover una pata.',
		image:
			'https://images.unsplash.com/photo-1533738363-b7f9aef128ce?w=1000&auto=format&fit=crop&q=85',
		alt: 'Gato usando gafas de sol negras',
		style: 'product-card--glasses',
	},
	{
		name: 'Hot dog, literalmente',
		type: 'Broma · clásico instantáneo',
		description: 'El chiste se cuenta solo. Tu perro, no.',
		image:
			'https://thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Hotdog_dog_costume_%288106428599%29.jpg/960px-Hotdog_dog_costume_%288106428599%29.jpg',
		alt: 'Perro con un disfraz de perrito caliente',
		credit:
			'https://commons.wikimedia.org/wiki/File:Hotdog_dog_costume_(8106428599).jpg',
		creditName: 'Petful · Wikimedia Commons',
		style: 'product-card--hotdog',
	},
];
---

<Layout>
	<header class="site-header">
		<a class="wordmark" href="#inicio" aria-label="WTF PETS? — inicio">
			WTF <span>PETS?</span><i aria-hidden="true">✳</i>
		</a>
		<nav class="site-nav" aria-label="Navegación principal">
			<a href="#inicio">Inicio</a>
			<a href="#disfraces">Disfraces</a>
			<a href="#accesorios">Accesorios</a>
			<a href="#bromas">Artículos de broma</a>
		</nav>
		<a class="header-note" href="#productos">PARA MASCOTAS<br />CON ACTITUD <span>↘</span></a>
	</header>

	<main>
		<section class="hero" id="inicio" aria-labelledby="hero-title">
			<div class="hero-copy">
				<p class="eyebrow"><span class="eyebrow-dot"></span> El club de las mascotas mal vestidas</p>
				<h1 id="hero-title">WTF <span>PETS?</span></h1>
				<p class="hero-headline">PEQUEÑOS MODELOS.<br /><span>GRANDES CRÍMENES</span><br />DE MODA.</p>
				<p class="hero-description">
					Disfraces y accesorios ridículamente divertidos para tus compañeros de cuatro patas.
					La vergüenza es tuya. La foto, también.
				</p>
				<div class="hero-actions">
					<a class="button button-dark" href="#productos">Ver productos <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="#categorias">Conoce la manada <span aria-hidden="true">↓</span></a>
				</div>
				<div class="hero-doodle" aria-hidden="true">NO<br />JUZGUES<br />EL LOOK.</div>
			</div>
			<div class="hero-visual">
				<div class="hero-photo">
					<img
						src="https://thumb.wikimedia.org/wikipedia/commons/thumb/4/43/2015_Hallowenn_dog_costume_party_3.jpg/960px-2015_Hallowenn_dog_costume_party_3.jpg"
						alt="Perro luciendo un disfraz en una fiesta de Halloween para mascotas"
						fetchpriority="high"
					/>
				</div>
				<div class="photo-sticker" aria-label="Cero vergüenza, cien por ciento estilo">
					<span>CERO</span><strong>VERGÜENZA</strong><span>100% ESTILO</span>
				</div>
				<span class="photo-caption">EL LOOK: DISCUTIBLE. LA ACTITUD: IMPECABLE.</span>
			</div>
			<div class="hero-bottom-line" aria-hidden="true">
				<span>DISFRACES PARA LOS QUE YA SON EL CENTRO DE ATENCIÓN</span>
				<span>WTF PETS?® — EDICIÓN PELUDA</span>
			</div>
		</section>

		<section class="categories-section" id="categorias" aria-labelledby="categories-title">
			<div class="section-topline">
				<p class="eyebrow"><span class="eyebrow-dot"></span> Tres formas de causar sensación</p>
				<span>DESLIZA LA MIRADA ↓</span>
			</div>
			<div class="categories-heading">
				<h2 id="categories-title">¿QUÉ TAN <span>EXTRA</span><br />ES TU MASCOTA?</h2>
				<p>Encuentra su próximo momento<br />de fama. O de confusión.</p>
			</div>
			<div class="category-grid">
				{categories.map((category) => (
					<article class={`category-card ${category.style}`} id={category.id}>
						<a class="category-image" href="#productos" aria-label={`Explorar ${category.name}`}>
							<img src={category.image} alt={category.alt} loading="lazy" />
							<span class="category-number">{category.number} / WTF</span>
							<span class="category-arrow" aria-hidden="true">↗</span>
						</a>
						<div class="category-copy">
							<h3>{category.name}</h3>
							<p>{category.description}</p>
							<a class="category-link" href="#productos">Ver la idea <span aria-hidden="true">↗</span></a>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="products-section" id="productos" aria-labelledby="products-title">
			<div class="products-header">
				<div>
					<p class="eyebrow dark-eyebrow"><span class="eyebrow-dot"></span> Futuros favoritos</p>
					<h2 id="products-title">PRESENTAMOS:<br /><span>EL CAOS.</span></h2>
				</div>
				<p class="products-note">Una probadita de lo que se viene.<br />Sin carrito, sin presión. Pura risa.</p>
			</div>
			<div class="product-grid">
				{products.map((product, index) => (
					<article class={`product-card ${product.style}`}>
						<div class="product-image">
							<img src={product.image} alt={product.alt} loading="lazy" />
							<span class="product-stamp">IDEA<br />DEMO</span>
							<span class="product-index">0{index + 1}</span>
						</div>
						<div class="product-info">
							<p class="product-type">{product.type}</p>
							<h3>{product.name}</h3>
							<p class="product-description">{product.description}</p>
							<span class="coming-soon">Próximamente <span aria-hidden="true">↗</span></span>
							{product.credit && (
								<a
									class="photo-credit"
									href={product.credit}
									target="_blank"
									rel="noopener noreferrer"
								>
									Foto: {product.creditName}
								</a>
								<a
									class="photo-license"
									href="https://creativecommons.org/licenses/by/2.0/"
									target="_blank"
									rel="noopener noreferrer"
								>
									CC BY 2.0
								</a>
							)}
						</div>
					</article>
				))}
			</div>
			<p class="demo-note">Productos e imágenes de demostración. No hay venta ni disponibilidad anunciada.</p>
		</section>

		<section class="manifesto" id="manifiesto" aria-labelledby="manifesto-title">
			<div class="manifesto-image">
				<img
					src="https://images.unsplash.com/photo-1552053831-71594a27632d?w=1200&auto=format&fit=crop&q=90"
					alt="Golden retriever mirando tranquilamente a cámara"
					loading="lazy"
				/>
				<span class="manifesto-image-label">CARA DE: YO NO FUI.</span>
			</div>
			<div class="manifesto-copy">
				<p class="eyebrow"><span class="eyebrow-dot"></span> Nuestro manifiesto peludo</p>
				<h2 id="manifesto-title">TU MASCOTA<br />NO TIENE<br /><span>VERGÜENZA.</span><br />TÚ LE COMPRAS<br />EL DISFRAZ.</h2>
				<p>
					Y luego dices “solo una foto”. Lo entendemos. Aquí celebramos el humor, las caras
					imposibles y los accesorios cómodos que dejan a cada mascota moverse, jugar y ser ella misma.
				</p>
				<a class="button button-light" href="#categorias">Encuentra su look <span aria-hidden="true">↗</span></a>
				<span class="manifesto-star" aria-hidden="true">✳</span>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="footer-main">
			<a class="wordmark footer-wordmark" href="#inicio" aria-label="WTF PETS? — volver al inicio">
				WTF <span>PETS?</span><i aria-hidden="true">✳</i>
			</a>
			<p>Porque sí, el perro también necesita un disfraz de taco.</p>
			<nav aria-label="Navegación del pie de página">
				<a href="#inicio">Inicio</a>
				<a href="#disfraces">Disfraces</a>
				<a href="#accesorios">Accesorios</a>
				<a href="#bromas">Artículos de broma</a>
				<a href="#productos">Productos demo</a>
			</nav>
		</div>
		<div class="footer-bottom">
			<span>WTF PETS? — CERO SERIEDAD, MUCHO CUIDADO.</span>
			<a href="#inicio">Arriba, cuadrúpedo ↑</a>
		</div>
	</footer>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
		background: #f5f0e6;
	}

	:global(body) {
		margin: 0;
		color: #191916;
		font-family: 'DM Sans', Arial, sans-serif;
		-webkit-font-smoothing: antialiased;
	}

	:global(a) {
		color: inherit;
		text-decoration: none;
	}

	:global(a:focus-visible) {
		outline: 3px solid #f15a24;
		outline-offset: 4px;
	}
</style>
